# Endereço público do site, usado em links e SEO.
NEXT_PUBLIC_SITE_URL=

# ---------- Painel /admin ----------
# E-mail de login do proprietário.
ADMIN_EMAIL=
# Gere as duas linhas abaixo com: npm run admin:senha -- "senha forte"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Pasta onde o painel grava blog, imagens e configurações. Faça backup dela.
# Padrão: ./storage dentro do projeto. Em produção, prefira uma pasta fora do projeto (ex.: /var/lib/advogado).
CONTENT_DIR=
# Só use 1 se o site rodar sem HTTPS (não recomendado): permite o cookie de login em HTTP.
# ADMIN_COOKIE_INSECURE=

# ---------- Avaliações do Google (opcional) ----------
# Lista completa de avaliações (recomendado).
# Quem administra o perfil do Google autoriza o acesso uma vez.
# GOOGLE_BUSINESS_PARENT no formato accounts/ID/locations/ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_BUSINESS_PARENT=

# Alternativa limitada: a API de Places devolve no máximo 5 avaliações.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
